# Copia este archivo como .env (en local) o configura estas variables en tu hosting.
# El servidor NO arranca si falta alguna de estas claves.

# --- Stripe ---
# Usa claves de prueba en local. Las claves reales solo en el hosting de producción.
STRIPE_SECRET_KEY=sk_test_...

# Webhook: Stripe → Developers → Webhooks → Add endpoint
#   URL:    https://TU-DOMINIO/api/stripe/webhook
#   Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#            checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Firebase (Firestore) ---
# Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
# Pega aquí el contenido del JSON descargado en una sola línea, o codificado en base64.
# Es un secreto: no lo subas nunca al repositorio.
FIREBASE_SERVICE_ACCOUNT=

# --- Entradas ---
# Secreto para firmar los QR de las entradas.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No lo cambies una vez vendidas entradas (los QR dejarían de validar).
TICKET_SECRET=
# URL pública de la web (se usa en los enlaces de los emails)
PUBLIC_URL=https://tiketek.es
SALES_ENABLED=true

# --- Emails (https://resend.com) ---
# Obligatorio en producción. Sin clave, en local los emails se guardan en outbox/.
RESEND_API_KEY=re_...
EMAIL_FROM=Tiketek <entradas@tiketek.es>

# --- Servidor ---
# development permite trabajar en local; Render define production.
NODE_ENV=development
PORT=3000
# Minutos que se reservan las entradas mientras el cliente paga
RESERVATION_MINUTES=35
